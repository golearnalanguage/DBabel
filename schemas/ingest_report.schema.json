{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DBabel Ingest Report",
  "type": "object",
  "required": [
    "format_version",
    "source",
    "format",
    "backend",
    "status",
    "units_extracted",
    "locations_available",
    "structure",
    "warnings",
    "limitations"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "PARTIAL",
        "FAIL"
      ]
    },
    "units_extracted": {
      "type": "integer",
      "minimum": 0
    },
    "locations_available": {
      "type": "boolean"
    },
    "structure": {
      "type": "object",
      "required": [
        "status",
        "inspected",
        "uninspected"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "PARTIAL",
            "NOT_APPLICABLE",
            "UNVERIFIED"
          ]
        },
        "inspected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "uninspected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
