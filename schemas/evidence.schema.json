{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"DBabel Evidence Record",
  "type":"object",
  "required":["source_title","source_type","locator","retrieved_at","evidence_state"],
  "properties":{
    "source_title":{"type":"string","minLength":1},
    "organization":{"type":"string"},
    "source_type":{"type":"string"},
    "locator":{"type":"string","minLength":1},
    "product":{"type":"string"},
    "version":{"type":"string"},
    "publication_or_update_date":{"type":"string"},
    "retrieved_at":{"type":"string"},
    "support_note":{"type":"string"},
    "authority_match":{"type":"string","enum":["HIGH","MEDIUM","LOW","UNKNOWN"]},
    "context_match":{"type":"string","enum":["HIGH","MEDIUM","LOW","UNKNOWN"]},
    "version_match":{"type":"string","enum":["EXACT","ADJACENT","UNKNOWN","NOT_APPLICABLE"]},
    "evidence_state":{"type":"string","enum":["CURRENT","STALE","CONFLICTING","INSUFFICIENT"]}
  },
  "additionalProperties":false
}
