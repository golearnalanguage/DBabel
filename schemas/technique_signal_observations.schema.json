{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DBabel Translation Technique Signal Observations",
  "type": "object",
  "required": [
    "format_version",
    "mode",
    "observations"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "mode": {
      "type": "string",
      "enum": [
        "BILINGUAL_REVIEW",
        "TRANSLATE"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "text_role",
          "observed_signals"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "text_role": {
            "type": "string",
            "minLength": 1
          },
          "observed_signals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "signal_details": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "signal",
                "side",
                "detector_id",
                "matched_text"
              ],
              "properties": {
                "signal": {
                  "type": "string",
                  "minLength": 1
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "SOURCE",
                    "TARGET",
                    "CONTEXT"
                  ]
                },
                "detector_id": {
                  "type": "string",
                  "minLength": 1
                },
                "matched_text": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "required": [
        "surface_only",
        "semantic_inference_allowed",
        "signals_are_evidence",
        "signals_are_findings",
        "signals_authorize_repair",
        "signals_are_human_approval"
      ],
      "properties": {
        "surface_only": {
          "const": true
        },
        "semantic_inference_allowed": {
          "const": false
        },
        "signals_are_evidence": {
          "const": false
        },
        "signals_are_findings": {
          "const": false
        },
        "signals_authorize_repair": {
          "const": false
        },
        "signals_are_human_approval": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
