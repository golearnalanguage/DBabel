{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DBabel Translation Technique Candidate Report",
  "type": "object",
  "required": [
    "format_version",
    "registry_version",
    "mode",
    "policy",
    "units"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "BILINGUAL_REVIEW",
        "TRANSLATE"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "observations_are_evidence",
        "candidates_are_findings",
        "candidates_are_decisions",
        "candidates_authorize_repair",
        "candidates_are_human_approval"
      ],
      "properties": {
        "observations_are_evidence": {
          "const": false
        },
        "candidates_are_findings": {
          "const": false
        },
        "candidates_are_decisions": {
          "const": false
        },
        "candidates_authorize_repair": {
          "const": false
        },
        "candidates_are_human_approval": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "text_role",
          "observed_signals",
          "candidates",
          "unmatched_signals"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "text_role": {
            "type": "string",
            "minLength": 1
          },
          "observed_signals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "technique_id",
                "category",
                "risk",
                "matched_triggers",
                "quality_dimensions",
                "on_uncertainty"
              ],
              "properties": {
                "technique_id": {
                  "$ref": "translation_techniques.schema.json#/$defs/technique_id"
                },
                "category": {
                  "type": "string",
                  "minLength": 1
                },
                "risk": {
                  "$ref": "translation_techniques.schema.json#/$defs/risk_level"
                },
                "matched_triggers": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "quality_dimensions": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "translation_techniques.schema.json#/$defs/semantic_dimension"
                  }
                },
                "on_uncertainty": {
                  "const": "REVIEW"
                }
              },
              "additionalProperties": false
            }
          },
          "unmatched_signals": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
