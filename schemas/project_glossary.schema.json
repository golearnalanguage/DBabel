{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DBabel Project Glossary",
  "type": "object",
  "required": [
    "format_version",
    "entries"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "source",
        "behavior",
        "approval",
        "targets",
        "scope",
        "match"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "source": {
          "type": "object",
          "required": [
            "language",
            "term"
          ],
          "properties": {
            "language": {
              "type": "string",
              "minLength": 1
            },
            "term": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "behavior": {
          "type": "string",
          "enum": [
            "TRANSLATE",
            "PROTECT"
          ]
        },
        "approval": {
          "type": "string",
          "enum": [
            "DISCOVERED",
            "EVIDENCED",
            "USER_REVIEW",
            "PROJECT_APPROVED",
            "REJECTED"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "behavior": {
                "const": "TRANSLATE"
              }
            },
            "required": [
              "behavior"
            ]
          },
          "then": {
            "properties": {
              "targets": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "behavior": {
                "const": "PROTECT"
              }
            },
            "required": [
              "behavior"
            ]
          },
          "then": {
            "properties": {
              "targets": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "language",
        "term",
        "status"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "term": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "PREFERRED",
            "ADMITTED",
            "FORBIDDEN"
          ]
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "text_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "required": [
        "mode",
        "case_sensitive",
        "unicode_normalization"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "exact",
            "token"
          ]
        },
        "case_sensitive": {
          "type": "boolean"
        },
        "unicode_normalization": {
          "type": "string",
          "enum": [
            "none",
            "NFC"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
