{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DBabel Review Unit",
  "type": "object",
  "required": [
    "id",
    "source",
    "current_target",
    "location",
    "labels",
    "finding_refs",
    "qa_issue_refs",
    "evidence_refs",
    "requires_confirmation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "current_target": {
      "type": "string"
    },
    "suggested_target": {
      "type": "string"
    },
    "source_language": {
      "type": "string",
      "minLength": 1
    },
    "target_language": {
      "type": "string",
      "minLength": 1
    },
    "alignment": {
      "type": "string",
      "enum": [
        "ALIGNED",
        "AMBIGUOUS",
        "SPLIT",
        "MERGED",
        "UNALIGNED"
      ]
    },
    "text_role": {
      "type": "string"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "finding_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "qa_issue_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "anchor_ref": {
      "type": "string",
      "minLength": 1
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "context": {
      "type": "object",
      "properties": {
        "vendor": {
          "type": "string"
        },
        "product": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "text_role": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
