{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DBabel DOCX Explicit Alignment Map",
  "type": "object",
  "required": [
    "format_version",
    "alignments"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "alignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "target": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ALIGNED",
              "AMBIGUOUS",
              "SPLIT",
              "MERGED",
              "UNALIGNED"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
