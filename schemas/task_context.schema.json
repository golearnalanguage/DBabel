{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DBabel Task Context",
  "type": "object",
  "required": [
    "format_version",
    "mode",
    "format",
    "signals",
    "risk_tags"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "mode": {
      "type": "string",
      "enum": [
        "LOOKUP",
        "AUDIT",
        "BILINGUAL_REVIEW",
        "TRANSLATE",
        "REPAIR",
        "SOURCE_RESEARCH",
        "CLAIM_ROUTE",
        "GOVERNANCE"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "none",
        "txt",
        "md",
        "html",
        "docx",
        "docm",
        "pptx",
        "pptm",
        "xlsx",
        "xlsm",
        "pdf",
        "image",
        "json",
        "csv",
        "xml",
        "odt",
        "ods",
        "odp",
        "epub",
        "zip",
        "ole",
        "doc",
        "xls",
        "ppt",
        "other",
        "unknown"
      ]
    },
    "input_kind": {
      "type": "string",
      "enum": [
        "none",
        "inline_text",
        "file"
      ]
    },
    "preflight_status": {
      "type": "string",
      "enum": [
        "NOT_REQUIRED",
        "READY",
        "BLOCKED_FORMAT_CONFLICT",
        "BLOCKED_UNVERIFIED_FORMAT",
        "NO_BACKEND",
        "REPAIR_REQUIRES_DEDICATED_WORKFLOW"
      ]
    },
    "source_language": {
      "type": "string",
      "minLength": 1
    },
    "target_language": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "text_role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "signals": {
      "type": "object",
      "required": [
        "has_project_glossary",
        "aligned_bilingual_units",
        "structured_output",
        "needs_external_evidence",
        "external_research_requested",
        "public_research_permitted",
        "approved_resource_resolves_scope",
        "repair_requested",
        "repair_authorized"
      ],
      "properties": {
        "has_project_glossary": {
          "type": "boolean"
        },
        "aligned_bilingual_units": {
          "type": "boolean"
        },
        "structured_output": {
          "type": "boolean"
        },
        "needs_external_evidence": {
          "type": "boolean"
        },
        "external_research_requested": {
          "type": "boolean"
        },
        "public_research_permitted": {
          "type": "boolean"
        },
        "approved_resource_resolves_scope": {
          "type": "boolean"
        },
        "repair_requested": {
          "type": "boolean"
        },
        "repair_authorized": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "risk_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "technical_claim",
          "cross_product_mapping",
          "version_sensitive",
          "ui_label",
          "title_operation_mismatch",
          "execution_scope",
          "ui_object_mismatch",
          "negation_exception_all",
          "precondition_order",
          "number_unit_scope",
          "terminology_claim_split",
          "null_empty_unknown",
          "renamed_parameter_version",
          "project_wording_vs_ui",
          "same_token_different_role",
          "ocr_ambiguity",
          "placeholder_position",
          "pdf_reading_order",
          "merged_table_formula",
          "diagram_role_swap",
          "html_attribute_binding"
        ]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "signals": {
            "properties": {
              "repair_authorized": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "signals": {
            "properties": {
              "repair_requested": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "REPAIR"
          }
        }
      },
      "then": {
        "properties": {
          "signals": {
            "properties": {
              "repair_requested": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "input_kind"
        ],
        "properties": {
          "input_kind": {
            "const": "file"
          }
        }
      },
      "then": {
        "required": [
          "preflight_status"
        ]
      }
    }
  ]
}
