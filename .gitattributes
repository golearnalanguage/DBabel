# DBabel package integrity must be byte-stable across operating systems.
# Normalize repository text files to LF in both Git storage and worktrees.
* text=auto eol=lf

# Explicit binary formats.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.xlsm binary
*.pptx binary
*.zip binary
